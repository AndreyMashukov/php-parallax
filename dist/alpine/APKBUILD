# Maintainer: Andrei Mashukov <a.mashukoff@gmail.com>
# Contributor: Andrei Mashukov <a.mashukoff@gmail.com>
pkgname=php84-parallax
pkgver=0.2.0
pkgrel=0
pkgdesc="Go/Rust-semantic concurrency primitive for PHP — WaitGroup + spawn with isolated per-worker runtimes and snapshot-copy captures"
url="https://github.com/AndreyMashukov/php-parallax"
arch="all"
license="MIT"
depends="php84"
makedepends="php84-dev php84-zts autoconf gcc make musl-dev"
subpackages=""
source="$pkgname-$pkgver.tar.gz::https://github.com/AndreyMashukov/php-parallax/archive/refs/tags/v$pkgver.tar.gz"
builddir="$srcdir/php-parallax-$pkgver"

# Provided as a convenience alias so users can `apk add php-parallax` without
# remembering the PHP version suffix.
provides="php-parallax=$pkgver-r$pkgrel"

build() {
	cd "$builddir"
	# Hard-fail on non-ZTS PHP — the extension's #ifndef ZTS guard would
	# otherwise produce a confusing compile error.
	if ! php-config --enable-zts 2>/dev/null | grep -q yes \
		&& ! php -r 'exit((int)!ZEND_THREAD_SAFE);'; then
		msg "FATAL: php-parallax requires a ZTS PHP build"
		return 1
	fi

	phpize84
	./configure --with-php-config=/usr/bin/php-config84 --enable-parallax
	make -j"$(nproc)"
}

check() {
	cd "$builddir"
	make test TESTS=tests NO_INTERACTION=1 REPORT_EXIT_STATUS=1
}

package() {
	cd "$builddir"
	local extdir
	extdir=$(/usr/bin/php-config84 --extension-dir)
	install -d "$pkgdir$extdir"
	install -m 644 modules/parallax.so "$pkgdir$extdir/parallax.so"

	install -d "$pkgdir/etc/php84/conf.d"
	cat > "$pkgdir/etc/php84/conf.d/50_parallax.ini" <<-EOF
		; Enables the php-parallax extension. See https://github.com/AndreyMashukov/php-parallax
		extension=parallax.so
	EOF
}

sha512sums=""
# sha512 is filled in by abuild -F when the tarball is fetched.
