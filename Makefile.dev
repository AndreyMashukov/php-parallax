.PHONY: help core-test value-test asan-test stress-test leak-test ext-build ext-test docker-test-alpine docker-test-bookworm docker-test clean

CC          ?= clang
CFLAGS_BASE  = -std=c11 -Wall -Wextra -Wpedantic -Wno-unused-parameter -O0 -g
CFLAGS_ASAN  = -fsanitize=address,undefined -fno-omit-frame-pointer
INCLUDES     = -I. -Ivalue -Icore

CORE_SRC  := $(wildcard core/*.c)
VALUE_SRC := $(wildcard value/*.c)

help:
	@echo "  All dev targets are invoked via 'make -f Makefile.dev <target>'."
	@echo "  Top-level 'Makefile' is generated by phpize and gitignored."
	@echo ""
	@echo "make -f Makefile.dev value-test            # C-only unit tests for value/ under ASAN+UBSAN"
	@echo "make -f Makefile.dev core-test             # C-only unit tests for core/ under ASAN+UBSAN"
	@echo "make -f Makefile.dev stress-test           # 1k-spawn stress fixture"
	@echo "make -f Makefile.dev leak-test             # 10k-spawn RSS-drift gate"
	@echo "make -f Makefile.dev ext-build             # phpize + configure + make (requires ZTS PHP)"
	@echo "make -f Makefile.dev ext-test              # ext-build + make test (runs .phpt suite)"
	@echo "make -f Makefile.dev docker-test-alpine    # full pipeline inside php:8.4-zts-alpine"
	@echo "make -f Makefile.dev docker-test-bookworm  # full pipeline inside php:8.4-zts-bookworm"
	@echo "make -f Makefile.dev docker-test           # both Alpine and Bookworm"
	@echo "make -f Makefile.dev clean                 # remove build artifacts"

build-out:
	@mkdir -p build-out

value-test: build-out
	$(CC) $(CFLAGS_BASE) $(CFLAGS_ASAN) $(INCLUDES) \
		$(VALUE_SRC) tests/c/test_pack.c tests/c/test_clone.c tests/c/test_value.c \
		-o build-out/value-test
	./build-out/value-test

core-test: build-out
	$(CC) $(CFLAGS_BASE) $(CFLAGS_ASAN) $(INCLUDES) \
		$(VALUE_SRC) $(CORE_SRC) tests/c/test_waitgroup.c tests/c/test_queue.c \
		-lpthread -o build-out/core-test
	./build-out/core-test

stress-test: build-out
	$(CC) $(CFLAGS_BASE) $(CFLAGS_ASAN) $(INCLUDES) \
		$(VALUE_SRC) $(CORE_SRC) tests/c/stress_spawn.c \
		-lpthread -o build-out/stress-test
	./build-out/stress-test 1000

leak-test: build-out
	$(CC) $(CFLAGS_BASE) $(INCLUDES) \
		$(VALUE_SRC) $(CORE_SRC) tests/c/leak_spawn.c \
		-lpthread -o build-out/leak-test
	./build-out/leak-test 10000

asan-test: value-test core-test stress-test

ext-build:
	phpize
	./configure --enable-parallax
	$(MAKE) -j$$(nproc 2>/dev/null || sysctl -n hw.ncpu)

ext-test: ext-build
	$(MAKE) test TESTS=tests

docker-test-alpine:
	docker run --rm -v "$$PWD:/ext" -w /ext php:8.4-zts-alpine sh -c '\
		[ "$$(php -r "echo ZEND_THREAD_SAFE ? 1 : 0;")" = "1" ] || { echo "NOT ZTS"; exit 1; } && \
		apk add --no-cache $$PHPIZE_DEPS clang make && \
		make -f Makefile.dev value-test core-test && \
		make -f Makefile.dev ext-test'

docker-test-bookworm:
	docker run --rm -v "$$PWD:/ext" -w /ext php:8.4-zts-bookworm sh -c '\
		[ "$$(php -r "echo ZEND_THREAD_SAFE ? 1 : 0;")" = "1" ] || { echo "NOT ZTS"; exit 1; } && \
		apt-get update && apt-get install -y --no-install-recommends autoconf gcc clang make && \
		make -f Makefile.dev value-test core-test && \
		make -f Makefile.dev ext-test'

docker-test: docker-test-alpine docker-test-bookworm

clean:
	rm -rf build-out modules build .libs *.o *.lo *.la *.so
	rm -f config.h config.log config.status libtool Makefile.fragments Makefile.objects
	rm -f acinclude.m4 aclocal.m4 configure configure~ install-sh ltmain.sh missing mkinstalldirs
	rm -rf autom4te.cache .deps
