<?php

/**
 * Stub declarations for static analysis. The actual classes are registered
 * by the parallax extension at PHP_MINIT and never appear in PHP-land source.
 */

/**
 * @final
 */
final class WaitGroup
{
    public function __construct(?string $bootstrap = null) {}

    /**
     * @param  array<int|string, mixed>  $args
     */
    public function go(callable $task, array $args = []): void {}

    /**
     * @return array<int, ParallaxResult>
     */
    public function wait(): array {}

    public function count(): int {}
}

final class ParallaxResult
{
    public bool $ok;

    public mixed $value;

    public ?ParallaxWorkerError $error;
}

final class ParallaxWorkerError
{
    public string $class;

    public string $message;

    public int $code;

    public string $trace;
}

class CaptureError extends \Error {}

class SpawnError extends \Error {}
